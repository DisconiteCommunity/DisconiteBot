BOT_TOKEN=""
APPLICATION_ID=""
BOT_OWNER_ID=""

DATABASE_URL="mysql://user:password@127.0.0.1:3306/disconite_bot"

# Optional: separate database for `prisma migrate dev` shadow migrations
# SHADOW_DATABASE_URL="mysql://user:password@127.0.0.1:3306/disconite_bot_shadow"

PORT="3000"
ENV="development"
LOG_LEVEL="INFO"

# Optional: Disconite Weblate + forum (defaults shown)
# WEBLATE_BASE_URL="https://translate.disconite.net"
# WEBLATE_PROJECT_SLUG="resonite"
# WEBLATE_API_TOKEN=""
# DISCONITE_FORUM_BASE_URL="https://disconite.net"

# Optional: richer /resonite socials profile previews (official platform APIs only)
# YOUTUBE_API_KEY=""
# X_API_BEARER_TOKEN=""
# TWITCH_CLIENT_ID=""
# REDDIT_CLIENT_ID=""
# REDDIT_CLIENT_SECRET=""

# Optional: live Resonite metrics mirror (public API only; defaults if omitted)
# RESONITE_METRICS_POLL_SECONDS="60"
# RESONITE_METRICS_MAX_RETRIES="300"
