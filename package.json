{
  "name": "disconite-bot",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "build/main.js",
  "prisma": {
    "schema": "./prisma"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('build',{recursive:true,force:true}))\"",
    "build": "tsc -p ./tsconfig.json && node scripts/copy-prisma.js",
    "dev": "tsx src/main.ts",
    "watch": "nodemon --exec tsx src/main.ts",
    "start": "node --enable-source-maps build/main.js",
    "start:prod": "node --enable-source-maps build/main.js",
    "start:ts-node": "ts-node --esm src/main.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@discordjs/builders": "^1.14.1",
    "@discordx/importer": "^1.3.1",
    "@koa/bodyparser": "^6.0.0",
    "@koa/multer": "^4.0.0",
    "@koa/router": "^15.1.0",
    "@prisma/adapter-mariadb": "^7.1.0",
    "@prisma/client": "7.1.0",
    "discord.js": "^14.25.1",
    "discordx": "^11.13.3",
    "dotenv": "^17.2.3",
    "koa": "^3.1.1",
    "multer": "2.0.2",
    "mysql": "^2.18.1",
    "prisma": "7.1.0",
    "reflect-metadata": "^0.2.2",
    "ts-node": "^10.9.2",
    "typescript": "5.9.3",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/koa": "^3.0.1",
    "@types/koa__multer": "^2.0.8",
    "@types/koa__router": "^12.0.5",
    "@types/mysql": "^2.15.26",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.7.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.9.5",
    "tsx": "^4.23.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=7.0.0"
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node",
    "transpileOnly": true
  }
}
